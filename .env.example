# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API).
#
# Only the publishable key belongs here. There is no SUPABASE_SERVICE_ROLE_KEY in this
# application: the service role bypasses RLS, and every path in the app is meant to run
# under the caller's own tenant scope.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
